{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Категорія, під якою EF Core пише згенерований SQL. Level=Information — видно кожен запит.
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*",

  // Кожна глава курсу має власну базу даних на одному екземплярі SQL Server LocalDB.
  // LocalDB не потребує окремої інсталяції сервера — він іде разом із Visual Studio
  // та SQL Server Express. Перевірити: у терміналі виконати `sqllocaldb info`.
  "ConnectionStrings": {
    "Ch01": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch01_Introduction;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Ch01Migrations": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch01_Migrations;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    // Окрема "пісочниця" для уроку 1.4: тут можна безкарно видаляти й перестворювати БД.
    "Ch01Sandbox": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch01_Sandbox;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Ch03": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch03_Models;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Ch04": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch04_Relationships;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Ch04Lazy": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch04_LazyLoading;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True",
    "Ch06": "Server=(localdb)\\MSSQLLocalDB;Database=EfCoreExamples_Ch06_Queries;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  }
}
